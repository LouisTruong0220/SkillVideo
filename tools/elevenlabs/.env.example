# Copy file này thành .env rồi điền khóa thật.
# KHÔNG commit .env, KHÔNG gửi qua chat/Zalo/Drive.

# Lấy tại https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_dan_key_vao_day

# ID giọng đã nhân bản của anh Trường.
# Để trống lúc đầu; chạy `python clone-voice.py` hoặc `python test-ket-noi.py`
# rồi điền vào đây.
ELEVENLABS_VOICE_ID=

# Model. CHỈ 3 model dưới đây hỗ trợ TIẾNG VIỆT chính thức:
#   eleven_v3          - mới nhất, phát âm tiếng Việt tốt nhất (mặc định)
#   eleven_turbo_v2_5  - nhanh hơn, rẻ hơn
#   eleven_flash_v2_5  - nhanh nhất, rẻ nhất
#
# ĐỪNG dùng eleven_multilingual_v2 / eleven_turbo_v2 / eleven_flash_v2
# — chúng KHÔNG có tiếng Việt, sẽ đọc méo, không tròn vành rõ chữ.
ELEVENLABS_MODEL=eleven_v3
